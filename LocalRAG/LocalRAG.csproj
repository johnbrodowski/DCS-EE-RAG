<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="FastBertTokenizer" Version="1.0.28" />
    <PackageReference Include="Microsoft.Data.SqlClient" Version="6.1.3" />
    <PackageReference Include="Microsoft.Data.Sqlite" Version="10.0.1" />
    <PackageReference Include="Microsoft.Extensions.Caching.Memory" Version="10.0.1" />
    <!-- CPU build by default. Build with -p:UseDirectML=true for the DirectML build, which adds
         GPU inference (RAGConfiguration.GpuDeviceId) on any DirectX 12 GPU, AMD included. -->
    <PackageReference Include="Microsoft.ML.OnnxRuntime" Version="1.23.2" Condition="'$(UseDirectML)' != 'true'" />
    <PackageReference Include="Microsoft.ML.OnnxRuntime.DirectML" Version="1.23.0" Condition="'$(UseDirectML)' == 'true'" />
    <!-- Not used by any code; excluded from DirectML builds because it ships its own CPU
         onnxruntime.dll, which would overwrite the DirectML one. -->
    <PackageReference Include="Microsoft.ML.OnnxRuntimeGenAI" Version="0.11.4" Condition="'$(UseDirectML)' != 'true'" />
    <PackageReference Include="Newtonsoft.Json" Version="13.0.4" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\AIClients\AiMessagingCore\AiMessagingCore.csproj" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="BenchmarkData\eedag_benchmark_v1.json" />
    <EmbeddedResource Include="BenchmarkData\eedag_benchmark_v2.json" />
  </ItemGroup>

</Project>
